# App
APP_ENV=dev
APP_DEBUG=true

# DB
DB_DRIVER=pdo_pgsql
DB_HOST=sherparpa-postgres
DB_PORT=5432
DB_NAME=db
DB_USER=postgres
DB_PASSWORD=postgres
DB_CHARSET=utf8

# RabbitMQ
RABBITMQ_DSN=amqp://guest:guest@sherparpa-rabbitmq:5672/%2f
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Storage
STORAGE_PATH=var/storage
